root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[Dockerfile]
indent_size = 4

[*.sh]
end_of_line = lf

[*.sln]
indent_style = tab
