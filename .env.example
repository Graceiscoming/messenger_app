# คัดลอกไฟล์นี้เป็น `.env` (อยู่ในโฟลเดอร์เดียวกับ docker-compose.yml) แล้วแก้ค่า
# ห้าม commit ไฟล์ `.env` จริง (อยู่ใน .gitignore แล้ว)

# รหัสผ่าน PostgreSQL (user: messenger) ใช้ทั้ง container db และ api
# ตั้งให้ยาวและไม่ซ้ำกับที่อื่น
DB_PASSWORD=CHANGE_ME_db_password

# คีย์สำหรับเซ็น JWT ต้องมีความยาวอย่างน้อย 32 ตัวอักษร
# วิธีสร้าง (PowerShell 5.1 ขึ้นไป):
#   $b = New-Object byte[] 48; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
# วิธีสร้าง (bash / Git Bash):
#   openssl rand -base64 48
JWT_KEY=CHANGE_ME_generate_at_least_32_random_characters

# Origin ของเว็บที่อนุญาตให้เรียก API (CORS)
# ค่าเริ่มต้นเมื่อรันผ่าน docker compose คือ http://localhost (พอร์ต 80)
CORS_ORIGIN=http://localhost
