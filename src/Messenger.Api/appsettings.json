{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "RunMigrations": false,
  "Cors": {
    "Origins": []
  },
  "RateLimit": {
    "AuthPerMinute": 20
  },
  "Jwt": {
    "Issuer": "messenger",
    "Audience": "messenger-web",
    "Key": "",
    "AccessMinutes": 15,
    "RefreshDays": 7
  },
  "Storage": {
    "UploadPath": "/data/uploads",
    "MaxImageBytes": 5242880
  },
  "Chat": {
    "UnsendWindowHours": 24,
    "MaxMessageLength": 2000,
    "PageSize": 30,
    "MaxCaptionLength": 500
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 5
  }
}
